{
  "evidence-policy": {
    "description": "Deterministic release evidence and runtime safety policy (Selective Kernel Fusion)",
    "PreToolUse": [
      {
        "matcher": "run_command",
        "description": "Intercept git push and evaluate deterministic release gate",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/verify_release_gate.py --pre-tool",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "view_file",
        "description": "Record file inspection for Read-Before-Write invariant",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/guard_read_before_write.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "read_file",
        "description": "Record file inspection for Read-Before-Write invariant",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/guard_read_before_write.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "replace_file_content",
        "description": "Enforce Read-Before-Write invariant to prevent blind mutations",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/guard_read_before_write.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "edit_file",
        "description": "Enforce Read-Before-Write invariant to prevent blind mutations",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/guard_read_before_write.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "write_to_file",
        "description": "Enforce Read-Before-Write invariant to prevent blind mutations",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/guard_read_before_write.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "write_file",
        "description": "Enforce Read-Before-Write invariant to prevent blind mutations",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/guard_read_before_write.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "run_command",
        "description": "Enforce Anti-Exact-Retry invariant to halt runaway failure loops",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/guard_anti_retry.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "description": "Record tool failures and clear failures on successful edits for Anti-Exact-Retry",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/guard_anti_retry.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}