{
  "evidence-policy": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "description": "Intercept git push and evaluate deterministic release gate",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/verify-release-gate.sh --pre-tool",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
